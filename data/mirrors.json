{
  "version": 1,
  "note": "Adaptadores declarativos. O Chrome fica atrás do guia. Cada serviço descreve seletores; Netflix e YouTube têm URL de reprodução própria no código. Os demais usam o extrator genérico com estes seletores.",
  "services": [
    {
      "id": "netflix",
      "name": "Netflix",
      "kind": "netflix",
      "homeUrl": "https://www.netflix.com/browse",
      "searchUrl": "https://www.netflix.com/search?q={q}",
      "rowSelector": ".lolomoRow, .rowContainer",
      "rowTitleSelector": ".row-header-title, .rowTitle",
      "cardSelector": ".slider-item, .title-card, .boxart-container",
      "linkSelector": "a[href*='/watch/'], a[href*='/title/']",
      "imageSelector": "img.boxart-image, img.boxart-image-in-padded-container, img",
      "progressSelector": ".progress-bar, [role='progressbar']",
      "profileSelector": ".profile-name, [data-uia='profile-name']",
      "continueHints": ["continueWatching", "continuar", "continue watching"]
    },
    {
      "id": "youtube",
      "name": "YouTube",
      "kind": "youtube",
      "homeUrl": "https://www.youtube.com/",
      "searchUrl": "https://www.youtube.com/results?search_query={q}",
      "rowSelector": "ytd-rich-shelf-renderer, ytd-reel-shelf-renderer, ytd-item-section-renderer",
      "rowTitleSelector": "#title, #title-text, yt-formatted-string#title",
      "cardSelector": "ytd-rich-item-renderer, ytd-grid-video-renderer, ytd-video-renderer, ytd-reel-item-renderer",
      "linkSelector": "a#video-title-link, a#thumbnail, a[href*='watch']",
      "imageSelector": "ytd-thumbnail img, img#img, img",
      "progressSelector": "#progress, ytd-thumbnail-overlay-resume-playback-renderer #progress",
      "profileSelector": "button#avatar-btn, yt-img-shadow#avatar img",
      "continueHints": ["continuar assistindo", "continue watching", "history"]
    },
    {
      "id": "prime",
      "name": "Prime Video",
      "kind": "generic",
      "homeUrl": "https://www.primevideo.com/",
      "searchUrl": "https://www.primevideo.com/search?phrase={q}",
      "rowSelector": "section, [data-testid*='shelf'], [class*='tst-shelf']",
      "rowTitleSelector": "h2, [data-testid*='title']",
      "cardSelector": "[data-testid='card-container'], a[href*='/detail/'], a[href]",
      "linkSelector": "a[href*='/detail/'], a[href*='/watch'], a[href]",
      "imageSelector": "img",
      "progressSelector": "[role='progressbar']",
      "profileSelector": "[data-automation-id='nav-profile'], #pv-nav-profile",
      "continueHints": ["continuar", "continue watching"]
    },
    {
      "id": "hbo",
      "name": "HBO Max",
      "kind": "generic",
      "homeUrl": "https://play.max.com/",
      "searchUrl": "https://play.max.com/search?q={q}",
      "rowSelector": "[data-testid*='shelf'], section, [class*='Shelf']",
      "rowTitleSelector": "h2, [data-testid*='title']",
      "cardSelector": "a[href*='/video/'], a[href*='/show/'], a[href]",
      "linkSelector": "a[href]",
      "imageSelector": "img",
      "progressSelector": "[role='progressbar']",
      "profileSelector": "[data-testid='profile-button'], [data-testid='profilePicker']",
      "continueHints": ["continuar", "continue watching"]
    },
    {
      "id": "apple",
      "name": "Apple TV",
      "kind": "generic",
      "homeUrl": "https://tv.apple.com/",
      "searchUrl": "https://tv.apple.com/search?term={q}",
      "rowSelector": "section, [class*='shelf'], [data-testid*='shelf']",
      "rowTitleSelector": "h2, [class*='title']",
      "cardSelector": "a[href*='/movie/'], a[href*='/show/'], a[href*='/episode/'], a[href]",
      "linkSelector": "a[href]",
      "imageSelector": "img, picture source",
      "progressSelector": "[role='progressbar']",
      "profileSelector": "[data-testid='account-menu'], .profile-button",
      "continueHints": ["continuar", "continue watching"]
    },
    {
      "id": "disney",
      "name": "Disney+",
      "kind": "generic",
      "homeUrl": "https://www.disneyplus.com/home",
      "searchUrl": "https://www.disneyplus.com/search?q={q}",
      "rowSelector": "[data-testid*='set'], section, [class*='shelf']",
      "rowTitleSelector": "h2, [data-testid*='title']",
      "cardSelector": "a[href*='/play/'], a[href*='/browse/'], a[href]",
      "linkSelector": "a[href]",
      "imageSelector": "img",
      "progressSelector": "[role='progressbar']",
      "profileSelector": "[data-testid='profile-avatar'], [data-testid='profile-selection']",
      "continueHints": ["continuar", "continue watching"]
    },
    {
      "id": "globoplay",
      "name": "Globoplay",
      "kind": "generic",
      "homeUrl": "https://globoplay.globo.com/",
      "searchUrl": "https://globoplay.globo.com/busca/?q={q}",
      "rowSelector": "section, [data-testid*='shelf'], [class*='slider']",
      "rowTitleSelector": "h2, [data-testid*='title']",
      "cardSelector": "a[href*='/v/'], a[href*='/t/'], a[href]",
      "linkSelector": "a[href]",
      "imageSelector": "img",
      "progressSelector": "[role='progressbar']",
      "profileSelector": "[data-testid='user-menu'], .user-avatar",
      "continueHints": ["continuar assistindo", "continuar"]
    }
  ]
}
