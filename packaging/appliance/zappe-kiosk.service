[Unit]
Description=Zappe kiosk (one gamescope, Qt guide, Chrome inside)
After=pipewire.service pipewire-pulse.service

[Service]
Type=simple
Environment=PATH=%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/src/zappe/packaging/appliance/zappe-kiosk.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
