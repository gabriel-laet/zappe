# Unit de SISTEMA. Áudio HDMI sai pela sessão do usuário no seat0
# (PipeWire do usuário). getty@tty1 fica mascarado; esta unit ocupa o tty.
#
# Specifiers de usuário do systemd não servem numa unit de sistema: o
# gerenciador troca o home por /root e o uid por 0. O ExecStart deixa de
# existir e a unit entra em 203/EXEC em loop. O placeholder YOUR_USER é o
# usuário da TV. Troque antes de instalar:
#
#   sudo cp packaging/appliance/zappe-kiosk.service /etc/systemd/system/
#   sudo sed -i "s/YOUR_USER/$USER/g" /etc/systemd/system/zappe-kiosk.service
#   sudo systemctl daemon-reload
#   sudo systemctl mask getty@tty1.service
#   loginctl enable-linger "$USER"
#   sudo systemctl enable --now zappe-kiosk.service
#
# /home/YOUR_USER/bin/zappe-kiosk.sh deve chamar packaging/appliance/zappe-kiosk.sh.
# PAMName=login + TTYPath=/dev/tty1 colocam o processo na sessão do seat0.
# O PAM define o runtime e o barramento da sessão. O script completa os dois
# se ainda estiverem vazios, com o uid de User=. Não fixe /run/user/0.
[Unit]
Description=Zappe kiosk (gamescope no tty1, sessão no seat0)
After=systemd-user-sessions.service
Wants=systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
WorkingDirectory=/home/YOUR_USER
Environment=HOME=/home/YOUR_USER
Environment=USER=YOUR_USER
Environment=XDG_SESSION_TYPE=tty
ExecStart=/home/YOUR_USER/bin/zappe-kiosk.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
