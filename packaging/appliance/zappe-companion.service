[Unit]
Description=Zappe phone companion (device code + hidden Netflix login)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/bin:/usr/local/bin:/usr/bin:/bin
Environment=ZAPPE_COMPANION_PORT=80
Environment=ZAPPE_COMPANION_HOST=zappe-tv.local
# Port 80 so http://zappe-tv.local works without a colon.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=%h/bin/zappe-companion
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
