[Unit]
Description=Zappe appliance auto-update (pull main, rebuild binary)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Release builds on the TV box can take a while; default 90s would kill cargo.
TimeoutStartSec=1h
Environment=ZAPPE_SRC=%h/src/zappe
Environment=PATH=%h/.cargo/bin:%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/src/zappe/packaging/appliance/zappe-update.sh
Nice=10

[Install]
WantedBy=default.target
