[Unit]
Description=Zappe appliance auto-update (pull main, rebuild binary)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A Release build can take a while; the default start timeout is too short.
TimeoutStartSec=1h
Environment=ZAPPE_SRC=%h/src/zappe
Environment=ZAPPE_UNIT=zappe-kiosk.service
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/src/zappe/packaging/appliance/zappe-update.sh
Nice=10

[Install]
WantedBy=default.target
